<?xml version="1.0" encoding="utf-8"?>
<layout>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- The player box: 16:9 in portrait, the whole screen in fullscreen (set in code) -->
        <RelativeLayout
            android:id="@+id/playerContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black">

            <com.google.android.exoplayer2.ui.StyledPlayerView
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false" />

            <LinearLayout
                android:id="@+id/player_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_margin="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tv_start_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="00:00"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_end_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="00:00"
                        android:textColor="@android:color/white" />

                </LinearLayout>

                <SeekBar
                    android:id="@+id/sb_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="@android:color/white"
                    android:thumbTint="@android:color/white" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:id="@+id/iv_play_pause"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginTop="5dp"
                        android:contentDescription="Play or pause"
                        android:src="@drawable/ic_player_play" />

                    <ImageView
                        android:id="@+id/iv_backward_seek"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="5dp"
                        android:contentDescription="Back 10 seconds"
                        android:src="@drawable/ic_backward_10" />

                    <ImageView
                        android:id="@+id/iv_forward_seek"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="5dp"
                        android:contentDescription="Forward 10 seconds"
                        android:src="@drawable/ic_forward_10" />

                    <ImageView
                        android:id="@+id/iv_volume"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="5dp"
                        android:contentDescription="Mute or unmute"
                        android:src="@drawable/ic_volume_on" />

                    <SeekBar
                        android:id="@+id/sb_volume_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:max="100"
                        android:progressTint="@android:color/white"
                        android:thumbTint="@android:color/white" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_weight="1.5" />

                    <ImageView
                        android:id="@+id/iv_full_screen"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginTop="5dp"
                        android:contentDescription="Fullscreen"
                        android:src="@drawable/ic_full_screen" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/player_top_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_subtitles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:contentDescription="Subtitle tracks"
                    android:src="@drawable/closed_caption" />

                <ImageView
                    android:id="@+id/iv_audio_tracks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:contentDescription="Audio tracks"
                    android:src="@drawable/ic_audiotrack"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_video_quality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:contentDescription="Video quality"
                    android:src="@drawable/ic_quality"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/enter_pip_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:contentDescription="Picture in picture"
                    android:src="@drawable/ic_enter_pip" />

                <ImageView
                    android:id="@+id/iv_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:contentDescription="Playback speed"
                    android:src="@drawable/ic_speed" />
            </LinearLayout>

            <!-- Shown while playback waits for the network to come back -->
            <TextView
                android:id="@+id/tv_network_waiting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/loader"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="12dp"
                android:background="#99000000"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Waiting for network…"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Previous / next video as two normal-sized buttons, so tapping the picture
                 elsewhere toggles the controls instead of skipping to another video -->
            <LinearLayout
                android:id="@+id/episode_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center_vertical">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/prev_episode"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Previous video"
                    android:padding="8dp"
                    android:src="@drawable/ic_skip_previous" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="2" />

                <ImageView
                    android:id="@+id/next_episode"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Next video"
                    android:padding="8dp"
                    android:src="@drawable/ic_skip_next" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/nextEpisodeOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@drawable/controls_background"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Up next"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/playNextEpisodeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Play next video"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/error_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@android:color/white"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="@android:color/black" />

                <TextView
                    android:id="@+id/error_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAlignment="center"
                    tools:text="This is error message" />

            </LinearLayout>

            <!-- Last in the box so it draws above the other overlays; visible until the first frame -->
            <ProgressBar
                android:id="@+id/loader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:indeterminateTint="@android:color/white"
                android:visibility="visible" />

        </RelativeLayout>

    </LinearLayout>

</layout>
